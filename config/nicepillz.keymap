// DEFAULT
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// CUST Includes
#define HOST_OS 3  // Windows: unicode macros type through WinCompose (RAlt+U ... Enter).
#include "zmk-helpers/helper.h"
#include "unicode.h"

/********************/
/*      Layers      */
/********************/
#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define FN      3
#define KEYPAD  4
#define SYSTEM  5

/********************/
/* custom behaviors */
/********************/
// homerow mods
ZMK_BEHAVIOR(hrm, hold_tap,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <125>;
    global-quick-tap;
    bindings = <&kp>, <&kp>;
)

/**********************/
/* Leader definitions */
/**********************/
// Leader (bottom-left key) then a sequence. Windows virtual desktops / window moves.

/ {
    behaviors {
        leader: leader {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            euro   { sequence = <N4>;    bindings = <&euro_sign_l>; };
            //system { sequence = <ESC>; bindings = <&sl SYSTEM>; };
            desk_l { sequence = <D N1>;  bindings = <&kp LG(LC(LEFT))>; };   // previous virtual desktop
            desk_r { sequence = <D N2>;  bindings = <&kp LG(LC(RIGHT))>; };  // next virtual desktop
            win_l  { sequence = <W N1>;  bindings = <&kp LG(LS(LEFT))>; };   // move window to left monitor
            win_r  { sequence = <W N2>;  bindings = <&kp LG(LS(RIGHT))>; };  // move window to right monitor
        };
    };
};

// Combo

/********************/
/*  custom Keymaps  */
/********************/
// Windows layout following the Kinesis Advantage legends. Caps Lock position is Tab.
//
    // | ESC   | F1 | F2 | F3 | F4 | F5 | F6 | F7 | F8 |      | F9 | F10 | F11 | F12 | PSCRN| SLCK | PAUSE| KEYPAD| PROGRAM |
    // |   =   |  1   |  2   |  3   |  4   |  5   |                |  6   |  7   |  8   |  9   |  0   |  -   |
    // |  TAB  |  Q   |  W   |  E   |  R   |  T   |                |  Y   |  U   |  I   |  O   |  P   |  \   |
    // |  TAB  |  A   |  S   |  D   |  F   |  G   |                |  H   |  J   |  K   |  L   |  ;   |  '   |   (Caps Lock key = Tab)
    // | LEADER|  Z   |  X   |  C   |  V   |  B   |                |  N   |  M   |  ,   |  .   |  /   | SHIFT|
    //         |  `   | INS  | LEFT |RIGHT |                              |  UP  | DOWN |  [   |  ]   |
    //                                     | CTRL | ALT  |  | WIN  | CTRL |
    //                                            | HOME |  | PGUP |
    //                              | BSPC | DEL  | END  |  | PGDN | ENT  | SPC  |
    // DEL = LOWER when held, ENT = RAISE when held. LOWER+RAISE = FN. KEYPAD toggles the numpad. PROGRAM = SYSTEM when held.

ZMK_LAYER(default_layer,
    &kp ESC     &kp F1       &kp F2      &kp F3        &kp F4            &kp F5   &kp F6  &kp F7  &kp F8                    &kp F9       &kp F10          &kp F11    &kp F12 &kp PSCRN    &kp SLCK        &kp PAUSE_BREAK &tog KEYPAD  &mo SYSTEM
    &kp EQUAL   &kp N1       &kp N2      &kp N3        &kp N4            &kp N5                     &kp N6    &kp N7         &kp N8          &kp N9      &kp N0          &kp MINUS
    &kp TAB     &kp Q        &kp W       &kp E         &kp R             &kp T                      &kp Y     &kp U          &kp I           &kp O       &kp P           &kp BSLH
    &kp TAB     &hrm LGUI A  &hrm LALT S &hrm LCTRL D  &hrm LEFT_SHIFT F &kp G                      &kp H     &hrm LSHFT J   &hrm LCTRL K    &hrm LALT L &hrm LGUI SEMI  &kp SQT
    &leader     &kp Z        &kp X       &kp C         &kp V             &kp B                      &kp N     &kp M          &kp COMMA       &kp DOT     &kp SLASH       &kp LSHFT
                &kp GRAVE    &kp INSERT  &kp LEFT      &kp RIGHT                                              &kp UP         &kp DOWN        &kp LBKT    &kp RBKT
                                                            &kp LCTRL       &kp LALT         &kp RGUI   &kp RCTRL
                                                                            &kp HOME         &kp PG_UP
                                                &kp BSPC    &lt LOWER DEL   &kp END          &kp PG_DN  &lt RAISE ENTER   &kp SPACE
)

// LOWER (hold DEL): Windows desktop shortcuts on the F row, editing and arrows on the left/right hands.
    // F1 prev desktop, F2 next desktop, F3 task view, F4 new desktop, F8 input language,
    // F9 window to left monitor, F10 window to right monitor, F11 show desktop, F12 close desktop
ZMK_LAYER(lower_layer,
    &trans  &kp LG(LC(LEFT)) &kp LG(LC(RIGHT)) &kp LG(TAB) &kp LG(LC(D))    &trans  &trans  &trans  &kp LG(SPACE)     &kp LG(LS(LEFT))  &kp LG(LS(RIGHT))  &kp LG(D)  &kp LG(LC(F4))   &trans  &trans  &trans  &trans  &trans
    &trans  &trans      &trans      &trans      &trans      &trans                              &trans      &trans      &trans  &trans      &trans  &trans
    &trans  &trans      &trans      &trans      &trans      &kp DEL                             &trans      &trans      &trans  &trans      &trans  &trans
    &trans  &kp LC(A)   &kp LS(TAB) &kp LGUI    &kp TAB     &trans                              &kp LEFT    &kp DOWN    &kp UP  &kp RIGHT   &trans  &trans
    &trans  &kp LC(Z)   &kp LC(X)   &kp LC(C)   &kp LC(V)   &kp LC(B)                           &trans      &trans      &trans  &trans      &trans  &trans
            &trans      &trans      &trans      &trans                                                      &trans      &trans  &trans      &trans
                                                            &trans  &trans              &trans  &trans
                                                                    &trans              &trans
                                                    &trans  &trans  &trans              &trans  &trans  &trans
)

// RAISE (hold ENTER): window management (Win+arrows snap/maximise/minimise), zoom, brackets.
    // F1 snip (Win+Shift+S), F2 clipboard history (Win+V), F3 Explorer (Win+E), F4 settings (Win+I)
ZMK_LAYER(raise_layer,
    &trans  &kp LG(LS(S))  &kp LG(V)  &kp LG(E)  &kp LG(I)   &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
    &kp LC(EQUAL)   &trans  &trans  &trans   &trans   &trans                                                                &trans      &trans          &trans      &trans          &trans  &kp LC(MINUS)
    &trans          &trans  &trans  &kp LPAR &kp RPAR &trans                                                                &trans      &kp LG(M)       &trans      &trans          &trans  &trans
    &trans          &trans  &trans  &kp LBKT &kp RBKT &trans                                                                &kp LG(LEFT) &kp LG(DOWN)    &kp LG(UP)  &kp LG(RIGHT)   &trans  &trans
    &trans          &trans  &trans  &kp LBRC &kp RBRC &trans                                                                &trans      &trans          &trans      &trans          &trans  &trans
                    &trans  &trans  &trans   &trans                                                                         &trans      &trans          &trans      &trans
                                                  &trans  &trans        &trans  &trans
                                                          &trans        &trans
                                          &trans  &trans  &trans        &trans  &trans  &trans
)

// FN (LOWER + RAISE together): media keys on the F9-F12 / PrtSc / ScrLk / Pause positions.
ZMK_LAYER(fn_layer,
    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_STOP  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans                                              &trans  &trans  &trans  &trans
                                                  &trans  &trans        &trans  &trans
                                                          &trans        &trans
                                          &trans  &trans  &trans        &trans  &trans  &trans
)

// KEYPAD (toggle with the Keypad key): Kinesis-style embedded numpad on the right hand.
    // number row: 7 NumLk, 8 =, 9 /, 0 *, - -     U I O = 7 8 9, P = -     J K L = 4 5 6, ; = +
    // M , . = 1 2 3, / = Enter     UP = 0, DOWN = .
ZMK_LAYER(keypad_layer,
    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans      &kp KP_NUM  &kp KP_EQUAL  &kp KP_SLASH  &kp KP_ASTERISK  &kp KP_MINUS
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans      &kp KP_N7   &kp KP_N8     &kp KP_N9     &kp KP_MINUS     &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans      &kp KP_N4   &kp KP_N5     &kp KP_N6     &kp KP_PLUS      &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans      &kp KP_N1   &kp KP_N2     &kp KP_N3     &kp KP_ENTER     &trans
            &trans  &trans  &trans  &trans                                              &kp KP_N0   &kp KP_DOT    &trans        &trans
                                                  &trans  &trans        &trans  &trans
                                                          &trans        &trans
                                          &trans  &trans  &trans        &trans  &kp KP_ENTER  &trans
)

// SYSTEM (hold PROGRAM): ESC or = -> bootloader (flashing mode), F1-F4 Bluetooth profiles, F8 clear
// the current profile's bond, LEADER position / right ENTER -> ZMK Studio unlock.
ZMK_LAYER(system_layer,
    &bootloader  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans  &trans  &trans  &bt BT_CLR       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
    &bootloader  &trans  &trans  &trans  &trans  &trans                                                                   &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                                                   &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                                                   &trans  &trans  &trans  &trans  &trans  &trans
    &studio_unlock  &trans  &trans  &trans  &trans  &trans                                                              &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans                                                                                   &trans  &trans  &trans  &trans
                                                  &trans  &trans                                        &trans  &trans
                                                          &trans                                        &trans
                                      &bl BL_TOG  &trans  &trans                                        &trans  &studio_unlock  &trans
)

/****************************/
/*  Tri State Layer Switch  */
/****************************/
ZMK_CONDITIONAL_LAYER(fn_layer, LOWER RAISE, FN)
