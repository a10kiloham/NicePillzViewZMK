// DEFAULT
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// CUST Includes
#define HOST_OS 3  // Windows: unicode macros type through WinCompose (RAlt+U ... Enter).
#include "zmk-helpers/helper.h"
#include "unicode.h"

/********************/
/*      Layers      */
/********************/
// The LAYER key (F16) and a tap of the FUNCTION thumb key step through these in order, dots 1-5
// on the display.
#define DEFAULT   0
#define LOWER     1
#define FN        2
#define SYSTEM    3
#define BLUETOOTH 4

/********************/
/* custom behaviors */
/********************/
// F14 key: F14, or with Shift held the output switches between Bluetooth and USB.
ZMK_BEHAVIOR(f14_out, mod_morph,
    bindings = <&kp F14>, <&out OUT_TOG>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)

// FUNCTION thumb key: FN layer while held with another key, next layer when tapped on its own.
// Used as &fn_key FN <next layer>. hold-preferred: any key pressed while it is down is an FN key.
ZMK_BEHAVIOR(fn_key, hold_tap,
    flavor = "hold-preferred";
    tapping-term-ms = <200>;
    bindings = <&mo>, <&to>;
)

/**********************/
/* Leader definitions */
/**********************/
// Leader (PROGRAM + left Shift) then a sequence. Windows virtual desktops / window moves.

/ {
    behaviors {
        leader: leader {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            euro   { sequence = <N4>;    bindings = <&euro_sign_l>; };
            //system { sequence = <ESC>; bindings = <&sl SYSTEM>; };
            desk_l { sequence = <D N1>;  bindings = <&kp LG(LC(LEFT))>; };   // previous virtual desktop
            desk_r { sequence = <D N2>;  bindings = <&kp LG(LC(RIGHT))>; };  // next virtual desktop
            win_l  { sequence = <W N1>;  bindings = <&kp LG(LS(LEFT))>; };   // move window to left monitor
            win_r  { sequence = <W N2>;  bindings = <&kp LG(LS(RIGHT))>; };  // move window to right monitor
        };
    };
};

// Combo

/********************/
/*  custom Keymaps  */
/********************/
// Windows layout following the Kinesis Advantage legends. Caps Lock position is F5.
// ZMK Studio: connect over USB with the keyboard running normally (not in bootloader), then press
// the F13 key to unlock.
//
    // | ESC   | F1 | F2 | F3 | F4 | F5 | F6 | F7 | F8 |      | F9 | F10 | F11 | F12 |UNLOCK| F14  | PSCRN| LAYER | PROGRAM |   (F13 = Studio unlock, Shift+F14 = BT/USB output)
    // |   =   |  1   |  2   |  3   |  4   |  5   |                |  6   |  7   |  8   |  9   |  0   |  -   |
    // |  TAB  |  Q   |  W   |  E   |  R   |  T   |                |  Y   |  U   |  I   |  O   |  P   |  \   |
    // |  F5   |  A   |  S   |  D   |  F   |  G   |                |  H   |  J   |  K   |  L   |  ;   |  '   |   (Caps Lock key = F5)
    // | LSHFT |  Z   |  X   |  C   |  V   |  B   |                |  N   |  M   |  ,   |  .   |  /   | RSHFT|
    //         |  `   | WIN  | LEFT |RIGHT |                              |  UP  | DOWN |  [   |  ]   |
    //                                     | CTRL | ALT  |  | FUNC | CTRL |
    //                                            | HOME |  | PGUP |
    //                              | BSPC | DEL  | END  |  | PGDN | ENT  | SPC  |
    // BSPC, DEL and ENT are plain keys. PROGRAM (top right) = SYSTEM when held.
    // LAYER (F16) steps to the next layer: DEFAULT > LOWER > FN > SYSTEM > BLUETOOTH > DEFAULT.
    // FUNC (right thumb): FN layer while held with another key, same as LAYER when tapped alone.
    // Bluetooth: PROGRAM + F1-F4 select the profile, PROGRAM + F8 forgets all four. The same keys
    // work on the BLUETOOTH layer (dot 5).

ZMK_LAYER(default_layer,
    &kp ESC     &kp F1       &kp F2      &kp F3        &kp F4            &kp F5   &kp F6  &kp F7  &kp F8                    &kp F9       &kp F10          &kp F11    &kp F12 &studio_unlock  &f14_out        &kp PSCRN       &to LOWER  &mo SYSTEM
    &kp EQUAL   &kp N1       &kp N2      &kp N3        &kp N4            &kp N5                     &kp N6    &kp N7         &kp N8          &kp N9      &kp N0          &kp MINUS
    &kp TAB     &kp Q        &kp W       &kp E         &kp R             &kp T                      &kp Y     &kp U          &kp I           &kp O       &kp P           &kp BSLH
    &kp F5      &kp A        &kp S       &kp D         &kp F             &kp G                      &kp H     &kp J          &kp K           &kp L       &kp SEMI        &kp SQT
    &kp LSHFT   &kp Z        &kp X       &kp C         &kp V             &kp B                      &kp N     &kp M          &kp COMMA       &kp DOT     &kp SLASH       &kp RSHFT
                &kp GRAVE    &kp LGUI    &kp LEFT      &kp RIGHT                                              &kp UP         &kp DOWN        &kp LBKT    &kp RBKT
                                                            &kp LCTRL       &kp LALT         &fn_key FN LOWER  &kp RCTRL
                                                                            &kp HOME         &kp PG_UP
                                                &kp BSPC    &kp DEL         &kp END          &kp PG_DN  &kp ENTER         &kp SPACE
)

// LOWER (dot 2): Windows desktop shortcuts on the F row, editing and arrows on the left/right hands.
    // F1 prev desktop, F2 next desktop, F3 task view, F4 new desktop, F8 input language,
    // F9 window to left monitor, F10 window to right monitor, F11 show desktop, F12 close desktop
ZMK_LAYER(lower_layer,
    &trans  &kp LG(LC(LEFT)) &kp LG(LC(RIGHT)) &kp LG(TAB) &kp LG(LC(D))    &trans  &trans  &trans  &kp LG(SPACE)     &kp LG(LS(LEFT))  &kp LG(LS(RIGHT))  &kp LG(D)  &kp LG(LC(F4))   &trans  &trans  &trans  &to FN  &trans
    &trans  &trans      &trans      &trans      &trans      &trans                              &trans      &trans      &trans  &trans      &trans  &trans
    &trans  &trans      &trans      &trans      &trans      &kp DEL                             &trans      &trans      &trans  &trans      &trans  &trans
    &trans  &kp LC(A)   &kp LS(TAB) &kp LGUI    &kp TAB     &trans                              &kp LEFT    &kp DOWN    &kp UP  &kp RIGHT   &trans  &trans
    &trans  &kp LC(Z)   &kp LC(X)   &kp LC(C)   &kp LC(V)   &kp LC(B)                           &trans      &trans      &trans  &trans      &trans  &trans
            &trans      &trans      &trans      &trans                                                      &trans      &trans  &trans      &trans
                                                            &trans  &trans              &fn_key FN FN  &trans
                                                                    &trans              &trans
                                                    &trans  &trans  &trans              &trans  &trans  &trans
)

// FN (dot 3, or hold the FUNCTION thumb key): media keys. F6 mute, F7 volume down, F8 volume up,
// F9 previous, F10 play/pause, F11 next, F12 stop. The keys right of F12 stay the same as on
// every other layer.
ZMK_LAYER(fn_layer,
    &trans  &trans  &trans  &trans  &trans  &trans  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP     &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_STOP  &trans  &trans  &trans  &to SYSTEM  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans                                              &trans  &trans  &trans  &trans
                                                  &trans  &trans        &fn_key FN SYSTEM  &trans
                                                          &trans        &trans
                                          &trans  &trans  &trans        &trans  &trans  &trans
)

// SYSTEM (dot 4, or hold PROGRAM): ESC or = -> bootloader (flashing mode), F1-F4 select Bluetooth
// profile 1-4, F8 forgets all four Bluetooth pairings, Caps Lock key -> Caps Lock, left Shift ->
// leader key.
ZMK_LAYER(system_layer,
    &bootloader  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans  &trans  &trans  &bt BT_CLR_ALL   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &to BLUETOOTH  &trans
    &bootloader  &trans  &trans  &trans  &trans  &trans                                                                   &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                                                   &trans  &trans  &trans  &trans  &trans  &trans
    &kp CAPS  &trans  &trans  &trans  &trans  &trans                                                                 &trans  &trans  &trans  &trans  &trans  &trans
    &leader   &trans  &trans  &trans  &trans  &trans                                                                 &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans                                                                                   &trans  &trans  &trans  &trans
                                                  &trans  &trans                                        &fn_key FN BLUETOOTH  &trans
                                                          &trans                                        &trans
                                          &trans  &trans  &trans                                        &trans  &trans  &trans
)

// BLUETOOTH (dot 5): F1-F4 select Bluetooth profile 1-4, F8 forgets all four pairings. Everything
// else types normally.
ZMK_LAYER(bluetooth_layer,
    &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans  &trans  &trans  &bt BT_CLR_ALL   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &to DEFAULT  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                                                   &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                                                   &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                                                   &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                                                   &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans                                                                                   &trans  &trans  &trans  &trans
                                                  &trans  &trans                                        &fn_key FN DEFAULT  &trans
                                                          &trans                                        &trans
                                          &trans  &trans  &trans                                        &trans  &trans  &trans
)
