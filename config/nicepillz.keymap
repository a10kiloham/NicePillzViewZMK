// DEFAULT
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// CUST Includes
#define HOST_OS 3  // Windows: unicode macros type through WinCompose (RAlt+U ... Enter).
#include "zmk-helpers/helper.h"
#include "unicode.h"

/********************/
/*      Layers      */
/********************/
#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define FN      3
#define KEYPAD  4
#define SYSTEM  5
#define BLUETOOTH 6

/********************/
/* custom behaviors */
/********************/
// homerow mods
ZMK_BEHAVIOR(hrm, hold_tap,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <125>;
    global-quick-tap;
    bindings = <&kp>, <&kp>;
)

// Bluetooth layer, 9 key: clears the current profile's bond, but only after being held for 3 s.
// A shorter press does nothing.
ZMK_BEHAVIOR(bt_clr_hold, hold_tap,
    flavor = "tap-preferred";
    tapping-term-ms = <3000>;
    bindings = <&bt>, <&none>;
)

/**********************/
/* Leader definitions */
/**********************/
// Leader (PROGRAM + left Shift) then a sequence. Windows virtual desktops / window moves.

/ {
    behaviors {
        leader: leader {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            euro   { sequence = <N4>;    bindings = <&euro_sign_l>; };
            //system { sequence = <ESC>; bindings = <&sl SYSTEM>; };
            desk_l { sequence = <D N1>;  bindings = <&kp LG(LC(LEFT))>; };   // previous virtual desktop
            desk_r { sequence = <D N2>;  bindings = <&kp LG(LC(RIGHT))>; };  // next virtual desktop
            win_l  { sequence = <W N1>;  bindings = <&kp LG(LS(LEFT))>; };   // move window to left monitor
            win_r  { sequence = <W N2>;  bindings = <&kp LG(LS(RIGHT))>; };  // move window to right monitor
        };
    };
};

// Combo

/********************/
/*  custom Keymaps  */
/********************/
// Windows layout following the Kinesis Advantage legends. Caps Lock position is F5.
// ZMK Studio: connect over USB with the keyboard running normally (not in bootloader), then press
// the F13 key to unlock.
//
    // | ESC   | F1 | F2 | F3 | F4 | F5 | F6 | F7 | F8 |      | F9 | F10 | F11 | F12 |UNLOCK|  BT  | PSCRN| LAYER | PROGRAM |   (F13 = Studio unlock, F14 = BT)
    // |   =   |  1   |  2   |  3   |  4   |  5   |                |  6   |  7   |  8   |  9   |  0   |  -   |
    // |  TAB  |  Q   |  W   |  E   |  R   |  T   |                |  Y   |  U   |  I   |  O   |  P   |  \   |
    // |  F5   |  A   |  S   |  D   |  F   |  G   |                |  H   |  J   |  K   |  L   |  ;   |  '   |   (Caps Lock key = F5)
    // | LSHFT |  Z   |  X   |  C   |  V   |  B   |                |  N   |  M   |  ,   |  .   |  /   | RSHFT|
    //         |  `   | WIN  | LEFT |RIGHT |                              |  UP  | DOWN |  [   |  ]   |
    //                                     | CTRL | ALT  |  | PROG | CTRL |
    //                                            | HOME |  | PGUP |
    //                              | BSPC | DEL  | END  |  | PGDN | ENT  | SPC  |
    // BSPC, DEL and ENT are plain keys. PROGRAM (both keys) = SYSTEM when held.
    // LAYER steps to the next layer in a loop: DEFAULT > LOWER > RAISE > FN > KEYPAD > DEFAULT.
    // BT = BLUETOOTH layer, held or tapped before the next key.

ZMK_LAYER(default_layer,
    &kp ESC     &kp F1       &kp F2      &kp F3        &kp F4            &kp F5   &kp F6  &kp F7  &kp F8                    &kp F9       &kp F10          &kp F11    &kp F12 &studio_unlock  &sl BLUETOOTH   &kp PSCRN       &to LOWER  &mo SYSTEM
    &kp EQUAL   &kp N1       &kp N2      &kp N3        &kp N4            &kp N5                     &kp N6    &kp N7         &kp N8          &kp N9      &kp N0          &kp MINUS
    &kp TAB     &kp Q        &kp W       &kp E         &kp R             &kp T                      &kp Y     &kp U          &kp I           &kp O       &kp P           &kp BSLH
    &kp F5      &hrm LGUI A  &hrm LALT S &hrm LCTRL D  &hrm LSHFT F      &kp G                      &kp H     &hrm RSHFT J   &hrm LCTRL K    &hrm LALT L &hrm LGUI SEMI  &kp SQT
    &kp LSHFT   &kp Z        &kp X       &kp C         &kp V             &kp B                      &kp N     &kp M          &kp COMMA       &kp DOT     &kp SLASH       &kp RSHFT
                &kp GRAVE    &kp LGUI    &kp LEFT      &kp RIGHT                                              &kp UP         &kp DOWN        &kp LBKT    &kp RBKT
                                                            &kp LCTRL       &kp LALT         &mo SYSTEM &kp RCTRL
                                                                            &kp HOME         &kp PG_UP
                                                &kp BSPC    &kp DEL         &kp END          &kp PG_DN  &kp ENTER         &kp SPACE
)

// LOWER (LAYER key): Windows desktop shortcuts on the F row, editing and arrows on the left/right hands.
    // F1 prev desktop, F2 next desktop, F3 task view, F4 new desktop, F8 input language,
    // F9 window to left monitor, F10 window to right monitor, F11 show desktop, F12 close desktop
ZMK_LAYER(lower_layer,
    &trans  &kp LG(LC(LEFT)) &kp LG(LC(RIGHT)) &kp LG(TAB) &kp LG(LC(D))    &trans  &trans  &trans  &kp LG(SPACE)     &kp LG(LS(LEFT))  &kp LG(LS(RIGHT))  &kp LG(D)  &kp LG(LC(F4))   &trans  &trans  &trans  &to RAISE  &trans
    &trans  &trans      &trans      &trans      &trans      &trans                              &trans      &trans      &trans  &trans      &trans  &trans
    &trans  &trans      &trans      &trans      &trans      &kp DEL                             &trans      &trans      &trans  &trans      &trans  &trans
    &trans  &kp LC(A)   &kp LS(TAB) &kp LGUI    &kp TAB     &trans                              &kp LEFT    &kp DOWN    &kp UP  &kp RIGHT   &trans  &trans
    &trans  &kp LC(Z)   &kp LC(X)   &kp LC(C)   &kp LC(V)   &kp LC(B)                           &trans      &trans      &trans  &trans      &trans  &trans
            &trans      &trans      &trans      &trans                                                      &trans      &trans  &trans      &trans
                                                            &trans  &trans              &trans  &trans
                                                                    &trans              &trans
                                                    &trans  &trans  &trans              &trans  &trans  &trans
)

// RAISE (LAYER key): window management (Win+arrows snap/maximise/minimise), zoom, brackets.
    // F1 snip (Win+Shift+S), F2 clipboard history (Win+V), F3 Explorer (Win+E), F4 settings (Win+I)
ZMK_LAYER(raise_layer,
    &trans  &kp LG(LS(S))  &kp LG(V)  &kp LG(E)  &kp LG(I)   &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &to FN  &trans
    &kp LC(EQUAL)   &trans  &trans  &trans   &trans   &trans                                                                &trans      &trans          &trans      &trans          &trans  &kp LC(MINUS)
    &trans          &trans  &trans  &kp LPAR &kp RPAR &trans                                                                &trans      &kp LG(M)       &trans      &trans          &trans  &trans
    &trans          &trans  &trans  &kp LBKT &kp RBKT &trans                                                                &kp LG(LEFT) &kp LG(DOWN)    &kp LG(UP)  &kp LG(RIGHT)   &trans  &trans
    &trans          &trans  &trans  &kp LBRC &kp RBRC &trans                                                                &trans      &trans          &trans      &trans          &trans  &trans
                    &trans  &trans  &trans   &trans                                                                         &trans      &trans          &trans      &trans
                                                  &trans  &trans        &trans  &trans
                                                          &trans        &trans
                                          &trans  &trans  &trans        &trans  &trans  &trans
)

// FN (LAYER key): media keys. F6 mute, F7 volume down, F8 volume up, F9 previous, F10 play/pause,
// F11 next, F12 stop. The keys right of F12 stay the same as on every other layer.
ZMK_LAYER(fn_layer,
    &trans  &trans  &trans  &trans  &trans  &trans  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP     &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_STOP  &trans  &trans  &trans  &to KEYPAD  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans                                              &trans  &trans  &trans  &trans
                                                  &trans  &trans        &trans  &trans
                                                          &trans        &trans
                                          &trans  &trans  &trans        &trans  &trans  &trans
)

// KEYPAD (LAYER key): Kinesis-style embedded numpad on the right hand.
    // number row: 7 NumLk, 8 =, 9 /, 0 *, - -     U I O = 7 8 9, P = -     J K L = 4 5 6, ; = +
    // M , . = 1 2 3, / = Enter     UP = 0, DOWN = .
    // The 8 key is the main = key: Windows has no keypad = key and ignores that code.
ZMK_LAYER(keypad_layer,
    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &to DEFAULT  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans      &kp KP_NUM  &kp EQUAL     &kp KP_SLASH  &kp KP_ASTERISK  &kp KP_MINUS
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans      &kp KP_N7   &kp KP_N8     &kp KP_N9     &kp KP_MINUS     &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans      &kp KP_N4   &kp KP_N5     &kp KP_N6     &kp KP_PLUS      &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans      &kp KP_N1   &kp KP_N2     &kp KP_N3     &kp KP_ENTER     &trans
            &trans  &trans  &trans  &trans                                              &kp KP_N0   &kp KP_DOT    &trans        &trans
                                                  &trans  &trans        &trans  &trans
                                                          &trans        &trans
                                          &trans  &trans  &trans        &trans  &kp KP_ENTER  &trans
)

// SYSTEM (hold PROGRAM): ESC or = -> bootloader (flashing mode), F1-F4 Bluetooth profiles, F8 clear
// the current profile's bond, Caps Lock key -> Caps Lock, left Shift -> leader key.
ZMK_LAYER(system_layer,
    &bootloader  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans  &trans  &trans  &bt BT_CLR       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
    &bootloader  &trans  &trans  &trans  &trans  &trans                                                                   &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                                                   &trans  &trans  &trans  &trans  &trans  &trans
    &kp CAPS  &trans  &trans  &trans  &trans  &trans                                                                 &trans  &trans  &trans  &trans  &trans  &trans
    &leader   &trans  &trans  &trans  &trans  &trans                                                                 &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans                                                                                   &trans  &trans  &trans  &trans
                                                  &trans  &trans                                        &trans  &trans
                                                          &trans                                        &trans
                                          &trans  &trans  &trans                                        &trans  &trans  &trans
)

// BLUETOOTH (hold the BT key, or tap it and then press the key): number row 1-4 select the
// Bluetooth profile, 0 toggles the output between Bluetooth and USB, 9 held for 3 s clears the
// current profile's bond.
ZMK_LAYER(bluetooth_layer,
    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans      &trans  &trans  &trans  &bt_clr_hold BT_CLR  &out OUT_TOG  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans                                              &trans  &trans  &trans  &trans
                                                  &trans  &trans        &trans  &trans
                                                          &trans        &trans
                                          &trans  &trans  &trans        &trans  &trans  &trans
)

// No tri-state (LOWER + RAISE = FN) rule: a conditional layer is switched off again whenever its
// condition is not met, which would stop the LAYER key from selecting FN.
